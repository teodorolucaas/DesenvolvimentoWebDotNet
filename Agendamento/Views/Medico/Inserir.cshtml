@model Agendamento.Models.Medico
@{
    ViewData["Title"] = "Inserir Médico";
}

<h4>Médico</h4>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Inserir">
            <div class="mb-3">
                <label asp-for="Nome" class="control-label"></label>
                <input asp-for="Nome" class="form-control"/>
            </div>
            <div class="mb-3">
                <label asp-for="Crm" class="control-label"></label>
                <input asp-for="Crm" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Especialidade" class="control-label"></label>
                <input asp-for="Especialidade" class="form-control" />
            </div>
            <div class="mt-3">
                <input type="submit" value="Inserir" class="btn btn-outline-success" />
                <a asp-action="Index" class="btn btn-outline-info">Voltar</a>
            </div>
        </form>
    </div>
</div>
