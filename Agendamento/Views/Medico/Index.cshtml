@model List<Agendamento.Models.Medico>

<h1>Médicos</h1>

<p>
    <a asp-action="Inserir" class="btn btn-success">Inserir</a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nome</th>
            <th>CRM</th>
            <th>Especialidade</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var m in Model)
        {
            <tr>
                <td>@m.Id</td>
                <td>@m.Nome</td>
                <td>@m.Crm</td>
                <td>@m.Especialidade</td>
            </tr>
        }
    </tbody>
</table>
