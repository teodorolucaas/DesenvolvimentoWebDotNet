@model List<Agendamento.Models.Medico>

@{
	ViewData["Title"] = "Médicos";
}

<h1>Médicos</h1>

<p>
	<a asp-action="Inserir" class="btn btn-success">Inserir</a>
</p>

<table class="table table-striped table-hover">
	<thead>
		<tr>
			<th>Id</th>
			<th>Nome</th>
			<th>CRM</th>
			<th>Especialidade</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach(var item in Model)
		{
			<tr>
				<td>@item.Id</td>
				<td>@item.Nome</td>
				<td>@item.Crm</td>
				<td>@item.Especialidade</td>
				<td>
					<a asp-action="Edit">Editar</a> 
					<a asp-action="Remove">Remover</a>
				</td>			
			</tr>
		}
	</tbody>
</table>
